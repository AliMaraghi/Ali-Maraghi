[Unit]
Description=APEX Opportunity Scouts (read-only: events, jobs, one financial headline)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/apexdev/apex-work
ExecStart=/usr/bin/python3 -B /home/apexdev/apex-work/scripts/run_scouts.py
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=APEX_LLM_PROVIDER=ollama
Environment=APEX_OLLAMA_MODEL=qwen3:4b
Environment=APEX_OLLAMA_EMBED=bge-m3
TimeoutStartSec=1200
NoNewPrivileges=yes
UMask=0077
