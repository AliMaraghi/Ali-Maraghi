[Unit]
Description=APEX kernel run (propose-only; --once, no unattended real actions; humans approve in the console)
After=network.target

[Service]
Type=oneshot
User=apex
Group=apex
WorkingDirectory=/opt/apex/app
ExecStart=/opt/apex/app/.venv/bin/python3 -B /opt/apex/app/scripts/agents_runner.py --once
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/apex/app/runtime
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
