[Unit]
Description=APEX local agents (propose-only; humans approve in the console)
After=network.target apex-worker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=apexdev
WorkingDirectory=/home/apexdev/apex-work
ExecStart=/usr/bin/python3 -B /home/apexdev/apex-work/scripts/worker_loop.py --loop --interval 300
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/apexdev/apex-work/runtime
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
